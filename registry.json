    {
      "name": "popover",
      "type": "registry:ui",
      "title": "TIS Popover",
      "description": "Popover React com composição shadcn e comportamento Base UI, preservando a anatomia e os tokens públicos do DS TIS.",
      "author": "TIS Experience Engineering",
      "dependencies": [
        "@base-ui/react@1.6.0",
        "clsx@2.1.1",
        "lucide-react@1.28.0",
        "tailwind-merge@3.6.0",
        "ds-tis@github:tis-experience/ds-tis#dd4c906943847cb7664a72a0c7637a378b39adcc"
      ],
      "files": [
        {
          "path": "registry/tis/popover.tsx",
          "type": "registry:ui",
          "target": "@ui/popover.tsx"
        },
        {
          "path": "registry/tis/tis-utils.ts",
          "type": "registry:lib",
          "target": "@ui/tis-utils.ts"
        }
      ],
      "css": {
        "@import \"ds-tis/css\"": {},
        ".ds-tis-popover__positioner": {
          "z-index": "var(--ds-z-tooltip)",
          "max-inline-size": "var(--available-width)"
        },
        ".ds-popover__panel.ds-tis-popover__popup": {
          "position": "relative"
        },
        ".ds-tis-popover__arrow": {
          "inline-size": "var(--ds-space-none)",
          "block-size": "var(--ds-space-none)",
          "visibility": "hidden"
        },
        ".ds-tis-popover__positioner::before, .ds-tis-popover__positioner::after": {
          "position": "absolute",
          "box-sizing": "border-box",
          "z-index": "calc(var(--ds-z-tooltip) + 1)",
          "content": "none",
          "pointer-events": "none"
        },
        ".ds-tis-popover__positioner:has(> .ds-tis-popover__popup > .ds-tis-popover__arrow)::before, .ds-tis-popover__positioner:has(> .ds-tis-popover__popup > .ds-tis-popover__arrow)::after": {
          "content": "\"\""
        },
        ".ds-tis-popover__positioner::before": {
          "background": "var(--ds-popover-panel-border-color-default)",
          "background-color": "color-mix(in srgb, var(--ds-popover-panel-border-color-default), var(--ds-popover-body-color-default) 25%)"
        },
        ".ds-tis-popover__positioner::after": {
          "background": "var(--ds-popover-arrow-fill-default)"
        },
        ".ds-tis-popover__positioner[data-side=\"bottom\"]::before, .ds-tis-popover__positioner[data-side=\"bottom\"]::after": {
          "inset-block-end": "calc(100% - var(--ds-popover-panel-border-width-default))",
          "inset-inline-start": "50%",
          "clip-path": "polygon(0 100%, 50% 0, 100% 100%)",
          "transform": "translateX(-50%)"
        },
        ".ds-tis-popover__positioner[data-side=\"bottom\"]::before, .ds-tis-popover__positioner[data-side=\"top\"]::before": {
          "inline-size": "var(--ds-popover-arrow-base-default)",
          "block-size": "calc((var(--ds-popover-arrow-base-default) / 2) + var(--ds-popover-panel-border-width-default))"
        },
        ".ds-tis-popover__positioner[data-side=\"bottom\"]::after, .ds-tis-popover__positioner[data-side=\"top\"]::after": {
          "inline-size": "calc(var(--ds-popover-arrow-base-default) - (var(--ds-popover-panel-border-width-default) * 2))",
          "block-size": "calc(var(--ds-popover-arrow-base-default) / 2)"
        },
        ".ds-tis-popover__positioner[data-side=\"top\"]::before, .ds-tis-popover__positioner[data-side=\"top\"]::after": {
          "inset-block-start": "calc(100% - var(--ds-popover-panel-border-width-default))",
          "inset-inline-start": "50%",
          "clip-path": "polygon(0 0, 100% 0, 50% 100%)",
          "transform": "translateX(-50%)"
        },
        ".ds-tis-popover__positioner[data-side=\"left\"]::before, .ds-tis-popover__positioner[data-side=\"left\"]::after": {
          "inset-block-start": "50%",
          "inset-inline-start": "calc(100% - var(--ds-popover-panel-border-width-default))",
          "clip-path": "polygon(0 0, 100% 50%, 0 100%)",
          "transform": "translateY(-50%)"
        },
        ".ds-tis-popover__positioner[data-side=\"left\"]::before, .ds-tis-popover__positioner[data-side=\"right\"]::before": {
          "inline-size": "calc((var(--ds-popover-arrow-base-default) / 2) + var(--ds-popover-panel-border-width-default))",
          "block-size": "var(--ds-popover-arrow-base-default)"
        },
        ".ds-tis-popover__positioner[data-side=\"left\"]::after, .ds-tis-popover__positioner[data-side=\"right\"]::after": {
          "inline-size": "calc(var(--ds-popover-arrow-base-default) / 2)",
          "block-size": "calc(var(--ds-popover-arrow-base-default) - (var(--ds-popover-panel-border-width-default) * 2))"
        },
        ".ds-tis-popover__positioner[data-side=\"right\"]::before, .ds-tis-popover__positioner[data-side=\"right\"]::after": {
          "inset-block-start": "50%",
          "inset-inline-end": "calc(100% - var(--ds-popover-panel-border-width-default))",
          "clip-path": "polygon(100% 0, 0 50%, 100% 100%)",
          "transform": "translateY(-50%)"
        }
      },
      "docs": "Mantenha @import \"ds-tis/css\" como o primeiro import global. Use PopoverTitle e PopoverDescription para nome e descrição acessíveis.",
      "meta": {
        "provider": "Base UI",
        "providerRole": "output-provider",
        "status": "beta",
        "wave": "overlay"
      }
    },
