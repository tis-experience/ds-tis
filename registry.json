        }
      ],
      "css": {
        "@import \"ds-tis/css\"": {},
        "@layer components": {
          ".ds-tis-dialog__backdrop": {
            "position": "fixed",
            "inset": "0",
            "background-color": "var(--ds-modal-overlay-bg-default)",
            "z-index": "var(--ds-modal-overlay-z-index-default)"
          },
          ".ds-tis-dialog__viewport": {
            "position": "fixed",
            "inset": "0",
            "display": "flex",
            "align-items": "center",
            "justify-content": "center",
            "padding": "var(--ds-modal-overlay-padding-default)",
            "z-index": "var(--ds-modal-overlay-z-index-default)"
          },
          ".ds-tis-dialog__popup": {
            "position": "relative"
          },
          ".ds-modal .ds-tis-dialog__close": {
            "top": "var(--ds-space-sm)",
            "right": "var(--ds-space-sm)"
          }
        }
      },
      "docs": "Mantenha @import \"ds-tis/css\" como o primeiro import do CSS global.",
      "meta": {
        "provider": "Base UI",
        "status": "beta"
      }
