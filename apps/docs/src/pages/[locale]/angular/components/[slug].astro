---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import ComponentDocumentationPage from '../../../../components/ComponentDocumentationPage.astro';

export function getStaticPaths() {
  const slugs = ['accordion', 'alert', 'avatar', 'badge', 'breadcrumb', 'button', 'card', 'checkbox', 'combobox', 'divider', 'form-field', 'input', 'menu', 'modal', 'pagination', 'popover', 'radio', 'select', 'skeleton', 'spinner', 'table', 'tabs', 'textarea', 'toast', 'toggle', 'tooltip'] as const;
  return ['pt-br', 'en'].flatMap((locale) =>
    slugs.map((slug) => ({
      params: { locale, slug },
      props: { locale, slug },
    })),
  );
}

const { locale, slug } = Astro.props;
const names = { accordion: 'Accordion', alert: 'Alert', avatar: 'Avatar', badge: 'Badge', breadcrumb: 'Breadcrumb', button: 'Button', card: 'Card', checkbox: 'Checkbox', combobox: 'Combobox', divider: 'Divider', 'form-field': 'Form Field', input: 'Input Text', menu: 'Menu', modal: 'Modal', pagination: 'Pagination', popover: 'Popover', radio: 'Radio', select: 'Select', skeleton: 'Skeleton', spinner: 'Spinner', table: 'Table', tabs: 'Tabs', textarea: 'Textarea', toast: 'Toast', toggle: 'Toggle', tooltip: 'Tooltip' };
---

<StarlightPage
  frontmatter={{
    title: names[slug as keyof typeof names],
    description: locale === 'en' ? 'Native Angular output.' : 'Saída Angular nativa.',
    tableOfContents: false,
    lastUpdated: false,
  }}
>
  <ComponentDocumentationPage slug={slug} technology="angular" locale={locale} />
</StarlightPage>
