---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import ComponentDocumentationPage from '../../../../components/ComponentDocumentationPage.astro';

export function getStaticPaths() {
  const slugs = ['accordion', 'alert', 'badge', 'button', 'checkbox', 'combobox', 'input', 'menu', 'modal', 'popover', 'radio', 'select', 'tabs', 'textarea', 'toast', 'toggle', 'tooltip'] as const;
  return ['pt-br', 'en'].flatMap((locale) =>
    slugs.map((slug) => ({
      params: { locale, slug },
      props: { locale, slug },
    })),
  );
}

const { locale, slug } = Astro.props;
const names = { accordion: 'Accordion', alert: 'Alert', badge: 'Badge', button: 'Button', checkbox: 'Checkbox', combobox: 'Combobox', input: 'Input Text', menu: 'Menu', modal: 'Modal', popover: 'Popover', radio: 'Radio', select: 'Select', tabs: 'Tabs', textarea: 'Textarea', toast: 'Toast', toggle: 'Toggle', tooltip: 'Tooltip' };
---

<StarlightPage
  frontmatter={{
    title: names[slug as keyof typeof names],
    description: locale === 'en' ? 'Native Angular output.' : 'Saída Angular nativa.',
    tableOfContents: false,
    lastUpdated: false,
  }}
>
  <ComponentDocumentationPage slug={slug} technology="angular" locale={locale} />
</StarlightPage>
