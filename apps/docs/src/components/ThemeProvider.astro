---
import Default from '@astrojs/starlight/components/ThemeProvider.astro';
---

<Default />
<script is:inline>
  const root = document.documentElement;

  if (root) {
    const syncMode = () => {
      root.dataset.mode = root.dataset.theme === 'dark' ? 'dark' : 'light';
    };

    syncMode();
    window.__dsThemeModeController?.abort();
    const controller = new AbortController();
    window.__dsThemeModeController = controller;
    const { signal } = controller;

    document.addEventListener('change', (event) => {
      if (
        event.target instanceof HTMLSelectElement &&
        event.target.closest('starlight-theme-select')
      ) {
        syncMode();
      }
    }, { signal });

    window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', syncMode, { signal });

    document.addEventListener(
      'astro:before-swap',
      () => controller.abort(),
      { once: true, signal },
    );
  }
</script>
