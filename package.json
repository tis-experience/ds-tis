{
  "name": "ds-tis",
  "version": "1.0.0",
  "description": "White-label CSS design system with DTCG tokens, component contracts, and light/dark mode",
  "homepage": "https://tis-experience.github.io/ds-tis/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tis-experience/ds-tis.git"
  },
  "bugs": {
    "url": "https://github.com/tis-experience/ds-tis/issues"
  },
  "main": "css/design-system.css",
  "style": "css/design-system.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./css/design-system.css",
    "./css": "./css/design-system.css",
    "./css/design-system.css": "./css/design-system.css",
    "./accordion": "./js/accordion.js",
    "./accordion.js": "./js/accordion.js",
    "./combobox": "./js/combobox.js",
    "./combobox.js": "./js/combobox.js",
    "./modal": "./js/modal.js",
    "./modal.js": "./js/modal.js",
    "./popover": "./js/popover.js",
    "./popover.js": "./js/popover.js",
    "./toast": "./js/toast.js",
    "./toast.js": "./js/toast.js",
    "./menu": "./js/menu.js",
    "./menu.js": "./js/menu.js",
    "./tabs": "./js/tabs.js",
    "./tabs.js": "./js/tabs.js",
    "./tooltip": "./js/tooltip.js",
    "./tooltip.js": "./js/tooltip.js",
    "./theme": "./js/theme/index.js",
    "./theme/*": "./js/theme/*.js",
    "./metadata": "./docs/api/consumer-context.json",
    "./metadata/components": "./docs/api/components.json",
    "./metadata/tokens": "./docs/api/tokens.json",
    "./metadata/foundations": "./docs/api/foundations.json",
    "./metadata/adrs": "./docs/api/adrs.json",
    "./metadata/release-evidence": "./docs/api/release-figma-evidence.json",
    "./agent-guide": "./docs/agent-consumer-usage.md",
    "./agent-guide/en": "./docs/agent-consumer-usage.en.md",
    "./llms": "./docs/llms.txt",
    "./llms-full": "./docs/llms-full.txt",
    "./templates/*": "./docs/templates/*",
    "./package.json": "./package.json"
  },
  "files": [
    "css/",
    "docs/agent-consumer-usage.md",
    "docs/agent-consumer-usage.en.md",
    "docs/api/adrs.json",
    "docs/api/components.json",
    "docs/api/consumer-context.json",
    "docs/api/foundations.json",
    "docs/api/release-figma-evidence.json",
    "docs/api/tokens.json",
    "docs/llms.txt",
    "docs/llms-full.txt",
    "docs/templates/",
    "js/accordion.js",
    "js/combobox.js",
    "js/menu.js",
    "js/modal.js",
    "js/popover.js",
    "js/toast.js",
    "js/tabs.js",
    "js/tooltip.js",
    "js/package.json",
    "js/theme/"
  ],
  "keywords": [
    "design-system",
    "css",
    "tokens",
    "white-label",
    "dark-mode"
  ],
  "author": "TIS Experience Engineering",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "scripts": {
    "build:tokens": "node build-tokens.mjs",
    "sync:docs": "node scripts/sync-docs.mjs",
    "verify:tokens": "node scripts/tokens-verify.mjs",
    "build:api": "node scripts/build-api.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build --output-dir storybook-static",
    "build:storybook:pages": "storybook build --output-dir _site/storybook",
    "storybook:vnext": "storybook dev -p 6007 -c .storybook-vnext",
    "build:storybook:vnext": "storybook build -c .storybook-vnext --output-dir storybook-vnext-static",
    "build:storybook:vnext:pages": "storybook build -c .storybook-vnext --output-dir _site/next/storybook",
    "build:docs:vnext": "npm run build --workspace @tis/docs",
    "build:docs:vnext:pages": "npm run build:docs:vnext && node scripts/copy-vnext-docs.mjs",
    "build:shadcn-registry": "node scripts/build-shadcn-registry.mjs",
    "build:preview:vnext": "npm run build:docs:vnext:pages && npm run build:storybook:vnext:pages",
    "preview:vnext": "node scripts/preview-vnext.mjs",
    "build:pages": "node scripts/build-pages.mjs && npm run build:shadcn-registry && npm run test:storybook && npm run build:storybook:pages && npm run test:storybook:browser:pages && npm run build:docs:vnext:pages && npm run build:storybook:vnext:pages && npm run test:vnext && npm run test:vnext:browser && node scripts/test-pages-artifact.mjs",
    "build:llms": "node scripts/build-llms.mjs",
    "build:all": "npm run build:tokens && npm run build:icons && npm run sync:docs && npm run build:api && npm run build:llms && npm run verify:tokens && npm test",
    "prepublishOnly": "npm run build:all && npm run test:app-ready -- --release",
    "pack:check": "npm pack --dry-run && npm run test:audit-scenarios && npm run test:app-ready",
    "test": "node scripts/test-token-integrity.mjs && node scripts/test-css-references.mjs && node scripts/test-generators.mjs && node scripts/test-docs-consumption.mjs && node scripts/test-accordion-docs.mjs && node scripts/test-combobox-docs.mjs && node scripts/test-pagination-docs.mjs && node scripts/test-field-docs.mjs && node scripts/test-table-docs.mjs && node tests/toast/runtime.test.mjs && node scripts/test-interactive.mjs && node scripts/test-api-runtime.mjs && node scripts/test-consumer-context.mjs && node scripts/test-readiness-evidence.mjs && node scripts/test-component-readiness.mjs && node scripts/test-runtime-lifecycle.mjs && node scripts/test-theme-engine.mjs && node scripts/release-figma-evidence.mjs && npm run test:pages && node scripts/test-a11y.mjs && npm run test:a11y:theme-playground",
    "test:app-ready": "node scripts/test-app-ready.mjs",
    "test:audit-scenarios": "node scripts/test-audit-scenarios.mjs",
    "test:audit-scenarios:ci": "node scripts/test-audit-scenarios.mjs --skip-local-figma",
    "test:consumer-smoke": "node scripts/test-consumer-smoke.mjs",
    "test:shadcn-consumer": "node scripts/test-shadcn-consumer.mjs",
    "test:docs-consumption": "node scripts/test-docs-consumption.mjs",
    "test:runtime-lifecycle": "node scripts/test-runtime-lifecycle.mjs",
    "test:self": "node scripts/test-self.mjs",
    "test:readiness": "node scripts/test-component-readiness.mjs",
    "test:readiness:evidence": "node scripts/test-readiness-evidence.mjs",
    "test:theme": "node scripts/test-theme-engine.mjs",
    "test:storybook": "node scripts/test-storybook-catalog.mjs",
    "test:storybook:browser": "node scripts/test-storybook-browser.mjs",
    "test:storybook:browser:pages": "node scripts/test-storybook-browser.mjs --static-dir _site/storybook",
    "test:vnext": "node scripts/test-vnext-foundation.mjs && npm run test:vnext:bundle && npm run test:shadcn-registry",
    "test:vnext:bundle": "node scripts/test-vnext-bundle.mjs",
    "test:vnext:browser": "node scripts/test-vnext-browser.mjs",
    "test:shadcn-registry": "shadcn registry validate && node scripts/test-shadcn-registry.mjs",
    "test:a11y": "node scripts/test-a11y.mjs",
    "test:a11y:theme-playground": "node scripts/test-a11y.mjs --strict-load --server --filter theme-playground --zero-blocking",
    "test:visual": "node scripts/test-visual.mjs",
    "test:visual:update": "node scripts/test-visual.mjs --update",
    "sync:tokens-from-figma": "node scripts/sync-tokens-from-figma.mjs",
    "sync:tokens-from-figma:write": "node scripts/sync-tokens-from-figma.mjs --write",
    "build:registry": "node scripts/build-token-registry.mjs",
    "build:registry:init": "node scripts/build-token-registry.mjs --init",
    "verify:registry": "node scripts/build-token-registry.mjs --check",
    "security:check": "node scripts/security-check.mjs",
    "figma:plugin:check": "node --check figma-plugin/snapshot-exporter/code.js",
    "figma:snapshot:install": "node scripts/install-figma-snapshot.mjs",
    "figma:snapshot:refresh": "node scripts/refresh-figma-snapshot.mjs",
    "verify:figma-structure": "node scripts/verify-figma-structure.mjs",
    "audit:component-tokens": "node scripts/verify-figma-structure.mjs --strict-unused",
    "release:figma-evidence": "node scripts/release-figma-evidence.mjs --write",
    "verify:release-evidence": "node scripts/release-figma-evidence.mjs",
    "test:pages": "npm run build:pages",
    "agent:preflight": "node scripts/agent-preflight.mjs",
    "verify:agent-docs": "node scripts/verify-agent-docs.mjs",
    "agents:create-run": "node scripts/agents/create-run.mjs",
    "agents:validate-run": "node scripts/agents/validate-run.mjs",
    "agents:next-step": "node scripts/agents/next-step.mjs",
    "agents:gate": "node scripts/agents/gate.mjs",
    "agents:validate-matrix": "node scripts/agents/validate-matrix.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@base-ui/react": "1.6.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/html-vite": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@tokens-studio/sd-transforms": "^2.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide": "^1.18.0",
    "lucide-react": "1.28.0",
    "marked": "^18.0.2",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "4.16.0",
    "storybook": "^10.5.3",
    "style-dictionary": "5.4.4",
    "tailwind-merge": "3.6.0",
    "vite": "8.1.5"
  }
}
