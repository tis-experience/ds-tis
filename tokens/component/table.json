        "font-family": {
          "$type": "string",
          "$value": "{semantic.typography.body.font-family.sans}",
          "$description": "Família tipográfica da caption."
        },
        "font-size": {
          "$type": "dimension",
          "$value": "{semantic.typography.body.font-size.sm}",
          "$description": "Font-size da caption."
        },
        "font-weight": {
          "$type": "number",
          "$value": "{semantic.typography.body.font-weight.regular}",
          "$description": "Font-weight da caption."
        },
        "line-height": {
          "$type": "dimension",
          "$value": "{semantic.typography.body.line-height.sm}",
          "$description": "Line-height da caption."
        }
      },
      "cell": {
        "padding-x": {
          "sm": {
            "$type": "dimension",
            "$value": "{semantic.space.sm}",
            "$description": "Padding horizontal de Cell Small."
          },
          "md": {
            "$type": "dimension",
            "$value": "{semantic.space.md}",
            "$description": "Padding horizontal de Cell Medium."
          }
        },
        "padding-y": {
          "sm": {
            "$type": "dimension",
            "$value": "{semantic.space.xs}",
            "$description": "Padding vertical de Cell Small."
          },
          "md": {
            "$type": "dimension",
            "$value": "{semantic.space.sm}",
            "$description": "Padding vertical de Cell Medium."
          }
        },
        "gap": {
          "$type": "dimension",
          "$value": "{semantic.space.xs}",
          "$description": "Gap entre conteúdos compostos dentro de Cell."
        }
      },
      "divider": {
        "color": {
          "$type": "color",
          "$value": "{semantic.border.subtle}",
          "$description": "Cor do divider entre Rows."
        },
        "width": {
          "$type": "dimension",
          "$value": "{semantic.border.width.default}",
          "$description": "Espessura do divider entre Rows."
        }
      },
      "sort": {
        "icon-color": {
          "$type": "color",
          "$value": "{semantic.icon.color.subtle}",
          "$description": "Cor do ícone de ordenação."
        },
        "icon-size": {
          "sm": {
            "$type": "dimension",
            "$value": "{semantic.size.sm}",
            "$description": "Tamanho do ícone de ordenação Small."
          },
          "md": {
            "$type": "dimension",
            "$value": "{semantic.size.md}",
            "$description": "Tamanho do ícone de ordenação Medium."
          }
        },
        "icon-stroke-width": {
          "sm": {
            "$type": "dimension",
            "$value": "{semantic.icon.stroke-width.regular.16}",
            "$description": "Stroke-width do ícone de ordenação Small."
          },
          "md": {
            "$type": "dimension",
            "$value": "{semantic.icon.stroke-width.regular.20}",
            "$description": "Stroke-width do ícone de ordenação Medium."
          }
        }
      }
    }
