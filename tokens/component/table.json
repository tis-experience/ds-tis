        "font-family": {
          "$type": "string",
          "$value": "{semantic.typography.body.font-family.sans}",
          "$description": "Família tipográfica de Cell."
        },
        "font-size": {
          "sm": {
            "$type": "dimension",
            "$value": "{semantic.typography.body.font-size.sm}",
            "$description": "Font-size de Cell Small."
          },
          "md": {
            "$type": "dimension",
            "$value": "{semantic.typography.body.font-size.md}",
            "$description": "Font-size de Cell Medium."
          }
        },
        "font-weight": {
          "$type": "number",
          "$value": "{semantic.typography.body.font-weight.regular}",
          "$description": "Font-weight de Cell."
        },
        "line-height": {
          "sm": {
            "$type": "dimension",
            "$value": "{semantic.typography.body.line-height.sm}",
            "$description": "Line-height de Cell Small."
          },
          "md": {
            "$type": "dimension",
            "$value": "{semantic.typography.body.line-height.md}",
            "$description": "Line-height de Cell Medium."
          }
        },
        "letter-spacing": {
          "$type": "dimension",
          "$value": "{semantic.typography.body.letter-spacing.normal}",
          "$description": "Letter-spacing de Cell."
        }
      },
      "caption": {
        "color": {
          "$type": "color",
          "$value": "{semantic.content.subtle}",
          "$description": "Cor da caption da Table."
