{
  "component": {
    "table": {
      "container": {
        "bg": {
          "$type": "color",
          "$value": "{semantic.surface.default}",
          "$description": "Background do container da Table."
        }
      },
      "header": {
        "bg": {
          "$type": "color",
          "$value": "{semantic.background.subtle}",
          "$description": "Background da Header Row."
        },
        "color": {
          "$type": "color",
          "$value": "{semantic.content.strong}",
          "$description": "Cor do conteúdo de Header Cell."
        },
        "font-family": {
          "$type": "string",
          "$value": "{semantic.typography.body.font-family.sans}",
          "$description": "Família tipográfica de Header Cell."
        },
        "font-size": {
          "sm": {
            "$type": "dimension",
            "$value": "{semantic.typography.body.font-size.sm}",
            "$description": "Font-size de Header Cell Small."
          },
          "md": {
            "$type": "dimension",
            "$value": "{semantic.typography.body.font-size.md}",
            "$description": "Font-size de Header Cell Medium."
          }
        },
        "font-weight": {
          "$type": "number",
          "$value": "{semantic.typography.body.font-weight.semibold}",
          "$description": "Font-weight de Header Cell."
        },
        "line-height": {
          "sm": {
            "$type": "dimension",
            "$value": "{semantic.typography.body.line-height.sm}",
            "$description": "Line-height de Header Cell Small."
          },
          "md": {
            "$type": "dimension",
            "$value": "{semantic.typography.body.line-height.md}",
            "$description": "Line-height de Header Cell Medium."
          }
        },
        "letter-spacing": {
          "$type": "dimension",
          "$value": "{semantic.typography.body.letter-spacing.normal}",
          "$description": "Letter-spacing de Header Cell."
        }
      },
      "row": {
        "bg": {
          "default": {
            "$type": "color",
            "$value": "{semantic.surface.default}",
            "$description": "Background da Row Default."
          },
          "hover": {
            "$type": "color",
            "$value": "{semantic.surface.hover}",
            "$description": "Background da Row Hover."
          },
          "selected": {
            "$type": "color",
            "$value": "{semantic.toned.background.default}",
            "$description": "Background da Row Selected."
          }
        },
        "height": {
          "sm": {
            "$type": "dimension",
            "$value": "{semantic.size.xl}",
            "$description": "Altura da Row Small."
          },
          "md": {
            "$type": "dimension",
            "$value": "{semantic.size.2xl}",
            "$description": "Altura da Row Medium."
          }
        }
      },
      "body": {
        "color": {
          "$type": "color",
          "$value": "{semantic.content.default}",
          "$description": "Cor do conteúdo de Cell."
